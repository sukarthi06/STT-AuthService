{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": "" //Use comma to add multiple origins e.g., http://localhost:4200,http://localhost:4201
  },
  "ConnectionStrings": {
    "AuthDb": ""
  },
  "Jwt": {
    "Issuer": "https://auth.stt.local",
    "Audience": "stt-api",
    "AccessTokenMinutes": 15,
    "KeyVaultUri": "https://kv-stt-dev.vault.azure.net/",
    "KeyName": "auth-signing-key"
  },
  "Otlp": {
    "Endpoint": "",
    "Protocol": "",
    "TracesEndpoint": "",
    "MetricsEndpoint": ""
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/app-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  }
}