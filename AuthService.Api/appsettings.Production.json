{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": "" //Use comma to add multiple origins e.g., http://localhost:4200,http://localhost:4201
  },
  "ConnectionStrings": {
    "AuthDb": ""
  },
  "Jwt": {
    "Issuer": "https://auth.stt.local",
    "Audience": "stt-api",
    "AccessTokenMinutes": 15,
    "KeyVaultUri": "https://kv-stt-dev.vault.azure.net/",
    "KeyName": "auth-signing-key",
    "RefreshTokenIdleMinutes": 30,
    "RefreshTokenAbsoluteHours": 8
  },
  "Otlp": {
    "Endpoint": "",
    "Protocol": "",
    "TracesEndpoint": "",
    "MetricsEndpoint": ""
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.DataProtection": "Error",
        "Microsoft.Hosting.Lifetime": "Information",
        "Polly": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  }
}