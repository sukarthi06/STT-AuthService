{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "LogEfSql": true
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": "http://localhost:4200" //Use comma to add multiple origins e.g., http://localhost:4200,http://localhost:4201
  },
  "ConnectionStrings": {
    "AuthDb": "Server=localhost;Port=5432;Database=AuthDb;User Id=postgres;Password=sa;Include Error Detail=true"
  },
  "Jwt": {
    "Issuer": "https://auth.stt.local",
    "Audience": "stt-api",
    "AccessTokenMinutes": 15,
    "KeyVaultUri": "https://kv-stt-dev.vault.azure.net/",
    "KeyName": "auth-signing-key"
  },
  "Otlp": {
    "Endpoint": "http://localhost:4317",
    "Protocol": "http/protobuf",
    "TracesEndpoint": "",
    "MetricsEndpoint": ""
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/app-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  }
}